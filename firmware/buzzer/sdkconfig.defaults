# WKM Buzzer — default SDK configuration
# These values are applied before the project-specific sdkconfig.

# Wi-Fi
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32

# NVS
CONFIG_NVS_ENCRYPTION=n

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# HTTP client
CONFIG_ESP_HTTP_CLIENT_ENABLE_BASIC_AUTH=n

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# SNTP / NTP (part of lwip in ESP-IDF v5.x)
CONFIG_LWIP_SNTP_MAX_SERVERS=3

# Stack sizes (bytes)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_STACK_SIZE=16384
